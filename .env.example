# 3Sound Soundboard Configuration
# Copy this file to .env to customize settings locally

# Directory where audio files and cover art are stored (default: ./sounds)
SOUNDS_DIR=./sounds

# Local development server host & port
HOST=0.0.0.0
PORT=8000

# Supported audio file extensions (comma-separated, leading dots optional)
# AUDIO_EXTENSIONS=.mp3,.m4a,.ogg,.wav,.flac,.aac,.wma,.webm,.opus,.aiff

# Base filenames searched for folder covers (comma-separated, checked with image extensions)
# FOLDER_IMAGE_NAMES=folder,cover,icon,thumb,thumbnail,album

# Hide empty folders in Folder View that contain 0 audio files (default: true)
# HIDE_EMPTY_FOLDERS=true

# Extract and stream embedded cover art (ID3, FLAC, M4A, Vorbis) on-the-fly (default: true)
# Keeps the sounds directory strictly read-only with zero disk writes.
# EXTRACT_EMBEDDED_ART=true

# Application branding title in navigation, browser tab, and PWA (default: Soundboard)
# APP_TITLE=Soundboard

# Default view mode on first open: 'flat' or 'folder' (default: flat)
# DEFAULT_VIEW_MODE=flat

# Default master playback volume percentage on first open (0-100, default: 80)
# DEFAULT_VOLUME=80

# Allow simultaneous/overlapping audio playback by default (default: true)
# DEFAULT_ALLOW_OVERLAP=true

# Start soundboard muted by default (default: false)
# DEFAULT_MUTED=false

# Maximum number of unique sound audio element pools retained in browser memory (default: 30)
# AUDIO_CACHE_SIZE=30
